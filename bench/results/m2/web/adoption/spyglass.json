      "command": ["npm", "run", "test"],
      "env": {"PATH": "/tmp/spyglass-m2-polka.dtXryw/tool-bin:/usr/bin:/bin:/usr/sbin:/sbin"},
      "timeoutMs": 300000
    },
    "owner-cleanup": {
      "command": ["sh", "-c", "pid=$(head -1 /tmp/spyglass-m2-polka.dtXryw/owner.pid); kill $pid; n=0; while curl --silent --max-time 1 http://127.0.0.1:${ownerPort}/health >/dev/null; do n=$((n+1)); test $n -lt 30 || exit 1; sleep 0.1; done; printf 'Owner listener stopped on port ${ownerPort}\\n'"],
      "cleanup": true,
      "timeoutMs": 10000
    }
  },
