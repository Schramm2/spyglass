    "doctor": ["sh", "-c", "test -s /tmp/spyglass-m2-polka.dtXryw/owner.pid && kill -0 $(head -1 /tmp/spyglass-m2-polka.dtXryw/owner.pid) && curl --fail --silent http://127.0.0.1:${ownerPort}/health"]
  },
  "bindings": {"ownerPort": "43187"},
