{
  "$id": "https://github.com/Schramm2/spyglass/schemas/v1/plan",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "controls": {
      "default": [],
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "claim": {
            "type": "string",
            "minLength": 1
          },
          "expectation": {
            "type": "string",
            "minLength": 1
          },
          "assertion": {
            "type": "string",
            "minLength": 1
          },
          "command": {
            "minItems": 1,
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "failure": {
            "type": "object",
            "properties": {
              "code": {
                "type": "string",
                "minLength": 1
              },
              "contains": {
                "type": "string",
                "minLength": 1
              }
            },
            "required": [
              "code",
              "contains"
            ],
            "additionalProperties": false
          }
        },
        "required": [
          "id",
          "claim",
          "expectation"
        ],
        "additionalProperties": false
      }
    },
    "claims": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "behavior": {
            "type": "string",
            "minLength": 1
          },
          "entryPoint": {
            "type": "string",
            "minLength": 1
          },
          "precondition": {
            "type": "string",
            "minLength": 1
          },
          "expected": {
            "type": "string",
            "minLength": 1
          },
          "case": {
            "type": "string",
            "minLength": 1
          },
          "checks": {
            "minItems": 1,
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "evidence": {
            "minItems": 1,
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "kind": {
            "default": "behavior",
            "type": "string",
            "enum": [
              "behavior",
              "visual",
              "side-effect"
            ]
          },
          "required": {
            "default": true,
            "type": "boolean"
          }
        },
        "required": [
          "id",
          "behavior",
          "entryPoint",
          "precondition",
          "expected",
          "case",
          "checks",
          "evidence",
          "kind",
          "required"
        ],
        "additionalProperties": false
      }
    },
    "gates": {
      "default": [],
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "limits": {
      "default": [],
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  },
  "required": [
    "controls",
    "claims",
    "gates",
    "limits"
  ],
  "additionalProperties": false
}
